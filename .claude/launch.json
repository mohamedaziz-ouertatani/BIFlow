{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "biflow-api",
      "runtimeExecutable": "python",
      "runtimeArgs": [
        "-m",
        "uvicorn",
        "agents.dashboard_agent.api:create_app",
        "--factory",
        "--port",
        "8000"
      ],
      "port": 8000
    },
    {
      "name": "biflow-frontend",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev", "--prefix", "frontend"],
      "port": 3000
    }
  ]
}
