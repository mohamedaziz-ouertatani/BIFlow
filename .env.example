# Copy to .env and fill in real values. Never commit the real .env file.

# Database (PostgreSQL data model)
DATABASE_URL=postgresql://biflow:biflow@localhost:5432/biflow

# LLM provider (used by BI Analyst, KPI/Semantic, and Auditor/XAI agents)
LLM_PROVIDER=anthropic
LLM_MODEL=
ANTHROPIC_API_KEY=

# Logging
LOG_LEVEL=INFO

# Dashboard
DASHBOARD_PORT=8501
