# Copy to .env and fill in real values. Never commit the real .env file.

# Database (PostgreSQL data model). This value is for docker-compose
# containers (env_file: .env), which reach Postgres via the `db` service
# hostname. From the host machine (e.g. running pytest directly), the
# mapped port is 5433, not 5432 -- shared/config.py defaults to
# postgresql://biflow:biflow@localhost:5433/biflow when DATABASE_URL isn't
# set in your shell, so you usually don't need to set this for local dev.
DATABASE_URL=postgresql://biflow:biflow@db:5432/biflow

# LLM provider (used by BI Analyst, KPI/Semantic, and Auditor/XAI agents)
LLM_PROVIDER=anthropic
LLM_MODEL=
ANTHROPIC_API_KEY=

# Logging
LOG_LEVEL=INFO

# Dashboard (frontend/, polls agents/dashboard_agent/api.py)
# Read client-side in the browser -- must be host-reachable, not the
# dashboard_agent docker service name.
NEXT_PUBLIC_API_URL=http://localhost:8000
